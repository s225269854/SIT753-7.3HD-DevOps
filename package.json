{
  "name": "nutrihelp-api",
  "version": "1.0.0",
  "description": "NutriHelp API with BLOCKING CI/CD Pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:mocha && npm run test:jest && npm run test:contract",
    "test:unit": "mocha \"test/unit/**/*.test.js\" --timeout 5000 --exit",
    "test:mocha": "mocha \"test/!(barcodeScanning|shoppingList|chatbot|healthArticles).test.js\" --timeout 5000 --exit",
    "test:jest": "npx jest test/barcodeScanning.test.js test/shoppingList.test.js test/chatbot.test.js test/healthArticles.test.js --testTimeout=10000 --forceExit",
    "test:contract": "npx jest test/contractTests/ --testTimeout=10000 --forceExit",
    "test:ci": "mocha \"./test/ci/**/*.test.js\" --timeout 5000 --exit",
    "lint": "eslint . --ext .js --max-warnings=0",
    "lint:ci": "eslint services routes middleware server.js test/ci --ext .js --max-warnings=50",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "openapi:validate": "swagger-cli validate index.yaml",
    "openapi:bundle": "swagger-cli bundle index.yaml -o openapi-bundled.yaml",
    "security:audit": "npm audit --audit-level=moderate",
    "build": "node -c server.js",
    "validate": "npm run lint && npm run format:check && npm test && npm run openapi:validate && npm run security:audit"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "cross-spawn": "^7.0.6",
    "eslint": "8.57.0",
    "jest": "^29.7.0",
    "mocha": "^11.3.0",
    "nyc": "^18.0.0",
    "prettier": "3.2.5",
    "proxyquire": "^2.1.3",
    "supertest": "7.1.4",
    "swagger-cli": "4.0.4"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@sendgrid/mail": "8.1.3",
    "@supabase/supabase-js": "2.86.0",
    "axios": "^1.16.0",
    "base64-arraybuffer": "^1.0.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "crypto": "1.0.1",
    "dotenv": "16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "7.5.0",
    "express-validator": "^7.3.2",
    "fs-extra": "11.3.1",
    "groq-sdk": "^1.1.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "node-fetch": "3.3.2",
    "nodemailer": "^8.0.7",
    "prom-client": "^15.1.3",
    "sinon": "18.0.0",
    "swagger-ui-express": "5.0.0",
    "tar": "^7.5.13",
    "twilio": "5.9.0",
    "winston": "^3.11.0",
    "yamljs": "0.3.0"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
